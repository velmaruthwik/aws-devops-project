pipeline {
    agent any

    stages {

        stage('Checkout Validation') {
            steps {
                echo 'Checking files'
                sh 'ls -la'
            }
        }

        stage('Build') {
            steps {
                echo 'Static website build completed'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                sudo cp index.html /var/www/html/index.html
                '''
            }
        }
    }
}
